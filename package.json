{
  "name": "snapquest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "npm run test:core",
    "test:core": "node --test \"test/*.test.mjs\"",
    "test:rls:catalog": "node scripts/validate-catalog-rls.mjs",
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "serve": "vite --host 0.0.0.0 --port 5173",
    "mobile": "expo start",
    "mobile:android": "expo start --android",
    "mobile:web": "expo start --web"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "supabase": "^2.105.0",
    "typescript": "~5.9.2",
    "vite": "^6.4.3"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "uuid": "^11.1.1"
  },
  "dependencies": {
    "@expo-google-fonts/cinzel": "^0.4.2",
    "@expo-google-fonts/exo-2": "^0.4.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@shopify/react-native-skia": "2.2.12",
    "@supabase/supabase-js": "^2.108.1",
    "babel-preset-expo": "~54.0.10",
    "expo": "~54.0.35",
    "expo-blur": "~15.0.8",
    "expo-camera": "~17.0.10",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-media-library": "~18.2.1",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-video": "~3.0.16",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-native": "^0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.5.1"
  },
  "main": "expo-router/entry"
}
