# SnapQuest public frontend envs
# Use these names in local .env files.
# Safe for frontend only when using the Supabase anon/public key.
# Never put private/admin database keys in frontend files.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_OWNER_EMAIL=

# Supabase Edge Function secrets must stay outside the frontend:
# GEMINI_API_KEY=
# GEMINI_MODELS=

# RLS catalog validation only. Use local .env, never commit real passwords.
RLS_TEST_COMMON_EMAIL=
RLS_TEST_COMMON_PASSWORD=
RLS_TEST_OWNER_EMAIL=
RLS_TEST_OWNER_PASSWORD=
