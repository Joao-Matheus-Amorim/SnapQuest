# SnapQuest public frontend envs
# Use these names in Vercel and local .env files.
# Safe for frontend only when using the Supabase anon/public key.
# Never put private/admin database keys in frontend files.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_OWNER_EMAIL=
EXPO_PUBLIC_GEMINI_API_KEY=
# Opcional. Lista de modelos grátis (separados por vírgula), tentados em ordem
# com fallback automático em 429/404. Default já soma ~580 chamadas/dia.
# Evite gemini-2.0-flash / gemini-2.0-flash-lite: cota grátis ZERO.
# Ex.: EXPO_PUBLIC_GEMINI_MODELS=gemini-3.1-flash-lite,gemini-2.5-flash,gemini-2.5-flash-lite
EXPO_PUBLIC_GEMINI_MODELS=